{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-audit.mjs\"",
            "timeout": 10,
            "statusMessage": "Recording skill usage"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/skill-audit.mjs\"",
            "timeout": 10,
            "statusMessage": "Recording skill usage"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/no-comments.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking for code comments"
          }
        ]
      }
    ]
  }
}
